# Copie para .env (`cp .env.example .env`) e troque as senhas e o segredo.
# O .env nunca vai para o repositório. Valores abaixo servem só para desenvolvimento local.

# --- MySQL (lidas pelo docker-compose.yml) ---------------------------------
# Porta publicada no host, somente em 127.0.0.1. Mude se a 3306 já estiver em uso.
MYSQL_PORT=3306
MYSQL_DATABASE=ocorrencias
MYSQL_USER=ocorrencias
# Obrigatórias: o compose não sobe sem elas.
# Só valem na primeira subida (quando o volume é criado). Para trocar depois: docker compose down -v.
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# --- API (NestJS) --------------------------------------------------------------
# A API lê este arquivo na subida e valida as variáveis abaixo: se alguma estiver inválida,
# ela não sobe e lista o que corrigir. Variável exportada no shell tem precedência sobre o .env.
# Obrigatória: development | test | production. Não tem padrão de propósito: Swagger e o modo
# de autenticação no MySQL dependem dela, e um ambiente esquecido não pode cair em "development".
NODE_ENV=development
# Porta HTTP da API (padrão 3000). O proxy do web (apps/web/proxy.conf.json) aponta para
# http://localhost:3000: se mudar aqui, ajuste lá também.
API_PORT=3000
# Conexão do Prisma (API e CLI). Repete usuário, senha, porta e banco do bloco MySQL acima:
# se mudar algum deles, ajuste aqui também. Senha com caractere especial vai codificada
# (%40 para @, %23 para #, %2F para /); URL inválida impede a API de subir.
DATABASE_URL="mysql://ocorrencias:troque-esta-senha@localhost:3306/ocorrencias"
# Banco sombra usado só pelo `prisma migrate dev` para gerar migrações. O compose cria este banco
# e dá acesso ao usuário acima na primeira subida (docker/mysql/init).
SHADOW_DATABASE_URL="mysql://ocorrencias:troque-esta-senha@localhost:3306/ocorrencias_shadow"
# Banco dos testes e2e da API (`npm run test:e2e -w @ocorrencias/api`). Eles aplicam as migrações
# nele e apagam todos os dados a cada suíte, por isso o nome precisa terminar em _test. Sem esta
# variável, os e2e usam o banco da DATABASE_URL com o sufixo _test. O compose cria o banco e dá
# acesso ao usuário acima na primeira subida (docker/mysql/init).
DATABASE_URL_TEST="mysql://ocorrencias:troque-esta-senha@localhost:3306/ocorrencias_test"
# Swagger em /api/docs. Sem valor, fica ligado fora de produção e desligado em produção.
# SWAGGER_ENABLED=true
# Obrigatória: segredo de assinatura (HS256) do JWT do cookie de sessão, com 32+ caracteres.
# Vazio de propósito: a API não sobe sem ele. Gere um valor aleatório e não reaproveite entre ambientes:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar o segredo derruba todas as sessões abertas (todo mundo precisa entrar de novo).
JWT_SECRET=
