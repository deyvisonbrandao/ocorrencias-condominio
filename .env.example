# Copie para .env (`cp .env.example .env`) e troque as senhas e o segredo.
# O .env nunca vai para o repositório. Valores abaixo servem só para desenvolvimento local.

# --- MySQL (lidas pelo docker-compose.yml) ---------------------------------
# Porta publicada no host, somente em 127.0.0.1. Mude se a 3306 já estiver em uso.
MYSQL_PORT=3306
MYSQL_DATABASE=ocorrencias
MYSQL_USER=ocorrencias
# Obrigatórias: o compose não sobe sem elas.
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# --- API (NestJS) --------------------------------------------------------------
NODE_ENV=development
# Porta HTTP da API (padrão 3000). O proxy do web (apps/web/proxy.conf.json)
# aponta para http://localhost:3000; se mudar aqui, ajuste lá também.
API_PORT=3000
# Conexão do Prisma (issue #2). Usuário, senha, porta e banco devem bater com o bloco MySQL acima.
DATABASE_URL="mysql://ocorrencias:troque-esta-senha@localhost:3306/ocorrencias"
# Segredo de assinatura do JWT de sessão (issue #6). Use um valor aleatório com 32+ caracteres,
# por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
